include README.md CHANGELOG.md AGENTS.md .gitignore .gitattributes .env.example MANIFEST_SHA256.json
recursive-include .github/workflows *.yaml *.yml
recursive-include config *.json
recursive-include docs *.md
recursive-include requirements *.txt
recursive-include registry *.json
recursive-include reference *.md *.json *.py
recursive-include provenance *.json *.zip
recursive-include tools *.py
recursive-include tests *.py *.json
recursive-include src/native_eset *.json *.py
prune .git
prune .pytest_cache
prune .venv
prune runs
prune build
prune dist
recursive-exclude * __pycache__ *.pyc *.pyo
